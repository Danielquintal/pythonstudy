def celsius_para_fahrenheit(c):
    return (c * 9/5) + 32

def fahrenheit_para_celsius(f):
    return (f - 32) * 5/9

opcao = input("Converter de (C)elsius para Fahrenheit ou (F)ahrenheit para Celsius? ").upper()
temperatura = float(input("Digite a temperatura: "))

if opcao == "C":
    print(f"{temperatura}°C = {celsius_para_fahrenheit(temperatura):.2f}°F")
elif opcao == "F":
    print(f"{temperatura}°F = {fahrenheit_para_celsius(temperatura):.2f}°C")
else:
    print("Opção inválida!")
