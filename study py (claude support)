import pandas as pd

df = pd.read_csv("consumo_alimentar.csv")
cidades_info = pd.read_csv("cidades_info.csv")

# Exercício 16
# Ordene o dataframe pela coluna "calorias", da maior para a menor,
# e mostre as 10 linhas com mais calorias.
df_sorted = df.sort_values(by="calorias", ascending=False)
print(df_sorted.head(10))

# Exercício 17
# Descubra qual pessoa (id_pessoa) consumiu mais calorias no total,
# somando todos os seus registros.
df_total_calorias = df.groupby("id_pessoa")["calorias"].sum()
pessoa_mais_calorias = df_total_calorias.idxmax()
print(f"A pessoa com mais calorias consumidas é: {pessoa_mais_calorias} com {df_total_calorias.max()} calorias.")


# Exercício 18
# Junte (merge) o dataframe "df" com "cidades_info" usando a coluna "cidade"
# como chave, trazendo região e população para cada registro.
df_merged = pd.merge(df, cidades_info, on="cidade", how="left")


# Exercício 19
# Depois de fazer o merge, calcule a média de calorias por região.
df_media_calorias_regiao = df_merged.groupby("regiao")["calorias"].mean()
print(df_media_calorias_regiao)

# Exercício 20
# Descubra se existe alguma cidade em "df" que NÃO aparece em "cidades_info"
# (dica: pesquise sobre o parâmetro "indicator=True" do merge, ou compare
# os valores únicos das duas colunas de cidade).
df_merge_check = pd.merge(df[["cidade"]].drop_duplicates(), cidades_info[["cidade"]].drop_duplicates(), on="cidade", how="outer", indicator=True)
cidades_nao_encontradas = df_merge_check[df_merge_check["_merge"] == "left_only"]["cidade"]
print("Cidades em df que não estão em cidades_info:", cidades_nao_encontradas.tolist())

