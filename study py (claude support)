# Exercício 15
# Converta a coluna "data" para o tipo datetime e crie uma nova coluna "mes"
# com o número do mês (1 a 12) de cada registro.
# Depois, mostre o total de calorias consumidas por mês.
def converter_data_e_criar_mes(df):
    df["data"] = pd.to_datetime(df["data"])
    df["mes"] = df["data"].dt.month
    calorias_por_mes = df.groupby("mes")["calorias"].sum()
    return calorias_por_mes
